NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Either full endpoint or base URL (the app will append endpoint if missing).
SCHEDULING_API_URL=https://scheduler-v2-gules.vercel.app/api/schedule
MEETING_ATTENDANCE_API_URL=https://hr-check-in-hnrx.vercel.app/api/report

# Executive AI (proxy-backed)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=deepseek-v3.1:671b-cloud
OLLAMA_MEMORY_MODEL=qwen3:8b
OLLAMA_API_KEY=replace-with-ollama-api-key
# Optional: reserved for MCP server integrations. If your MCP logic is hosted in this same app,
# set this to your deployed app URL (or omit if unused by your code path).
MCP_SERVER_BASE_URL=https://co-op-operations-intelligence-dashb.vercel.app
EXECUTIVE_AI_ENABLED=true
EXECUTIVE_TOOL_STATUS_STREAMING=true
EXECUTIVE_MAX_TOOL_CALLS=8
